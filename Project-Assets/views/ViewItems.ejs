<!-- Include the shared header layout from views/layouts/header.ejs.
     pageTitle controls the browser tab title.
     currentUser displays the logged-in user's name in the top bar.
     bodyClass applies page-specific body styling. -->
<%- include("layouts/header", { pageTitle, currentUser, bodyClass: "portal-home-body" }) %>
<%
    const safeLocationOptions = Array.isArray(locationOptions) ? locationOptions : [];
    const safeCategoryOptions = Array.isArray(categoryOptions) ? categoryOptions : [];
    const safeSelectedLocations = Array.isArray(filters.selectedLocations) ? filters.selectedLocations : [];
    const safeSelectedCategories = Array.isArray(filters.selectedCategories) ? filters.selectedCategories : [];

    // Add a visible "Other" option to the filter dropdowns
    // without duplicating it if it already exists.
    const locationFilterOptions = safeLocationOptions.includes("Other")
        ? safeLocationOptions
        : ["Other", ...safeLocationOptions];

    const categoryFilterOptions = safeCategoryOptions.includes("Other")
        ? safeCategoryOptions
        : ["Other", ...safeCategoryOptions];

    // Keep all selected filters during pagination and when returning from edit actions.
    function buildItemsFilterQuery(pageNumber) {
        const params = [];

        params.push("view=" + encodeURIComponent(inventoryView));

        if (pageNumber) {
            params.push("page=" + encodeURIComponent(pageNumber));
        }

        if (filters.search) {
            params.push("search=" + encodeURIComponent(filters.search));
        }

        if (filters.status) {
            params.push("status=" + encodeURIComponent(filters.status));
        }

        if (filters.sortBy) {
            params.push("sortBy=" + encodeURIComponent(filters.sortBy));
        }

        safeSelectedLocations.forEach(function(location) {
            params.push("location=" + encodeURIComponent(location));
        });

        safeSelectedCategories.forEach(function(category) {
            params.push("category=" + encodeURIComponent(category));
        });

        return params.join("&");
    }
%>
    <!-- Main content area for the inventory/storage page -->
    <main class="portal-home-main">
        <div class="container py-4">

            <!-- Page heading -->
            <section class="portal-page-header mb-4">
                <h1 class="portal-page-title">Lost and Found Storage</h1>
                <p class="text-muted">Manage logged items, track status, and find potential matches.</p>
                
                <div class="inventory-tabs mt-3">
                    <a href="/items?view=current"
                        class="inventory-tab <%= inventoryView === 'current' ? 'active' : '' %>">
                        Current Inventory
                    </a>
                    <a href="/items?view=archived"
                        class="inventory-tab <%= inventoryView === 'archived' ? 'active' : '' %>">
                        Archived
                    </a>
                </div>
            </section>

<!-- Search and Filter Toolbar -->
<section class="mb-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-3">
            <form action="/items" method="GET">
                <input type="hidden" name="view" value="<%= inventoryView %>">

                <!-- First row: search, status, sort, locations, categories -->
                <div class="row g-3 align-items-end">
                    <!-- Search textbox -->
                    <div class="col-xl-4 col-lg-6">
                        <label for="search" class="form-label small fw-bold">Search</label>

                        <!-- One normal input so it matches the other filter boxes -->
                        <div class="position-relative">
                            <i
                                class="bi bi-search position-absolute top-50 translate-middle-y text-muted"
                                style="left: 14px; z-index: 2;"
                            ></i>

                            <input
                                type="text"
                                name="search"
                                id="search"
                                class="form-control form-control-sm ps-5"
                                placeholder="ID, description, category..."
                                value="<%= filters.search %>"
                                style="height: 44px;"
                            >
                        </div>
                    </div>

                    <!-- Status dropdown -->
                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label for="status" class="form-label small fw-bold">Status</label>

                        <% if (inventoryView === 'current') { %>
                            <select
                                name="status"
                                id="status"
                                class="form-select form-select-sm"
                                style="height: 44px;"
                            >
                                <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All (Active)</option>
                                <option value="available" <%= filters.status === 'available' ? 'selected' : '' %>>Available</option>
                                <option value="pending_pickup" <%= filters.status === 'pending_pickup' ? 'selected' : '' %>>Pending Pickup</option>
                            </select>
                        <% } else { %>
                            <select
                                name="status"
                                id="status"
                                class="form-select form-select-sm"
                                style="height: 44px;"
                            >
                                <option value="all" selected>Archived</option>
                                <option value="returned">Returned</option>
                            </select>
                        <% } %>
                    </div>

                    <!-- Sort dropdown -->
                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label for="sortBy" class="form-label small fw-bold">Sort By</label>

                        <select
                            name="sortBy"
                            id="sortBy"
                            class="form-select form-select-sm"
                            style="height: 44px;"
                        >
                            <option value="top" <%= filters.sortBy === 'top' ? 'selected' : '' %>>Top Results</option>
                            <option value="matches" <%= filters.sortBy === 'matches' ? 'selected' : '' %>>Most Matches</option>
                            <option value="newest" <%= filters.sortBy === 'newest' ? 'selected' : '' %>>Date (Newest)</option>
                            <option value="oldest" <%= filters.sortBy === 'oldest' ? 'selected' : '' %>>Date (Oldest)</option>
                            <option value="category" <%= filters.sortBy === 'category' ? 'selected' : '' %>>Category (A-Z)</option>
                        </select>
                    </div>

                    <!-- Locations dropdown -->
                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label class="form-label small fw-bold d-block">Locations</label>

                        <div class="dropdown w-100" data-bs-auto-close="outside">
                            <button
                                type="button"
                                class="form-select form-select-sm text-start"
                                id="itemLocationDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="height: 44px; cursor: pointer;"
                            >
                                <%= safeSelectedLocations.length > 0
                                    ? "Selected (" + safeSelectedLocations.length + ")"
                                    : "All" %>
                            </button>

                            <div
                                class="dropdown-menu w-100 p-2 shadow-sm"
                                aria-labelledby="itemLocationDropdown"
                                style="max-height: 220px; overflow-y: auto;"
                            >
                                <% if (locationFilterOptions.length === 0) { %>
                                    <div class="small text-muted px-1">No locations available.</div>
                                <% } else { %>
                                    <% locationFilterOptions.forEach(function(option, index) { %>
                                        <div class="form-check mb-1">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="location"
                                                id="item-location-filter-<%= index %>"
                                                value="<%= option %>"
                                                <%= safeSelectedLocations.includes(option) ? 'checked' : '' %>
                                            >
                                            <label
                                                class="form-check-label small"
                                                for="item-location-filter-<%= index %>"
                                            >
                                                <%= option %>
                                            </label>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Categories dropdown -->
                    <div class="col-xl-2 col-lg-3 col-md-6">
                        <label class="form-label small fw-bold d-block">Categories</label>

                        <div class="dropdown w-100" data-bs-auto-close="outside">
                            <button
                                type="button"
                                class="form-select form-select-sm text-start"
                                id="itemCategoryDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false"
                                style="height: 44px; cursor: pointer;"
                            >
                                <%= safeSelectedCategories.length > 0
                                    ? "Selected (" + safeSelectedCategories.length + ")"
                                    : "All" %>
                            </button>

                            <div
                                class="dropdown-menu w-100 p-2 shadow-sm"
                                aria-labelledby="itemCategoryDropdown"
                                style="max-height: 220px; overflow-y: auto;"
                            >
                                <% if (categoryFilterOptions.length === 0) { %>
                                    <div class="small text-muted px-1">No categories available.</div>
                                <% } else { %>
                                    <% categoryFilterOptions.forEach(function(option, index) { %>
                                        <div class="form-check mb-1">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                name="category"
                                                id="item-category-filter-<%= index %>"
                                                value="<%= option %>"
                                                <%= safeSelectedCategories.includes(option) ? 'checked' : '' %>
                                            >
                                            <label
                                                class="form-check-label small"
                                                for="item-category-filter-<%= index %>"
                                            >
                                                <%= option %>
                                            </label>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Second row: Apply and Reset buttons on the right -->
                <div class="row mt-3">
                    <div class="offset-xl-8 col-xl-4 offset-lg-6 col-lg-6">
                        <div class="d-flex gap-2 justify-content-end">
                            <button
                                type="submit"
                                class="btn btn-brand btn-sm px-4"
                                style="height: 44px; min-width: 120px;"
                            >
                                Apply
                            </button>

                            <a
                                href="/items?view=<%= inventoryView %>"
                                class="btn btn-outline-secondary btn-sm px-4 d-flex align-items-center justify-content-center"
                                style="height: 44px; min-width: 120px;"
                            >
                                Reset
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

            <!-- Card section that holds either the empty-state message or the items table -->
            <section class="section-card">

                <!-- If there are no items in the array, show a message instead of the table -->
                <% if (items.length===0) { %>
                    <div class="empty-state p-5 text-center">
                        <i class="bi bi-inbox text-muted display-4 d-block mb-3"></i>
                        No items found matching your criteria.
                    </div>

                    <!-- Otherwise, show the table of items -->
                    <% } else { %>
                        <div class="table-responsive">

                            <!-- Bootstrap table for displaying all logged items -->
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <!-- Table column headers -->
                                        <th scope="col">ID</th>
                                        <th scope="col">Image</th>
                                        <th scope="col">Category</th>
                                        <th scope="col">Description</th>
                                        <th scope="col">Location</th>
                                        <th scope="col">Date Logged</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Matches</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <!-- Loop through each item in the items array -->
                                    <% items.forEach(function(item) { %>
                                        <tr>

                                            <!-- Display the item's unique ID -->
                                            <td>
                                                <%= item.id %>
                                            </td>

                                            <!-- Display the image label, or fallback text if no image exists -->
                                            <td>
                                                <div class="item-thumbnail-container" style="cursor: pointer;"
                                                    data-bs-toggle="modal" data-bs-target="#imagePreviewModal"
                                                    onclick="document.getElementById('fullSizeImage').src='<%= item.image_url %>'">
                                                    <% if (item.image_url) { %>
                                                        <img src="<%= item.image_url %>" alt="Item Image"
                                                            class="item-thumbnail" />
                                                        <% } else { %>
                                                            <div class="item-no-image">No Image</div>
                                                            <% } %>
                                                </div>
                                            </td>

                                            <!-- Display the item category -->
                                            <td>
                                                <%= item.category %>
                                            </td>

                                            <!-- Display the item description -->
                                            <td class="description-cell">
                                                <%= item.description %>
                                            </td>

                                            <!-- Display the location where the item was found/logged -->
                                            <td>
                                                <%= item.location %>
                                            </td>

                                            <!-- Display the date the item was logged -->
                                            <td>
                                                <%= new Date(item.created_at).toLocaleDateString() %>
                                            </td>

                                            <!-- Display the item status as a styled badge -->
                                            <td>
                                                <span
                                                    class="badge <%= item.status === 'available' ? 'bg-success' : (item.status === 'pending_pickup' ? 'bg-warning text-dark' : 'bg-secondary') %>">
                                                    <%= (item.status || 'available' ).replace('_', ' '
                                                        ).replace(/\b\w/g, l=> l.toUpperCase()) %>
                                                </span>
                                                <% if (item.claim_notes) { %>
                                                    <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip"
                                                        title="<%= item.claim_notes %>"></i>
                                                    <% } %>
                                            </td>

                                            <!-- Potential Matches Indicator -->
                                            <td>
                                                <div class="match-indicator" data-item-id="<%= item.id %>">
                                                    <button type="button"
                                                        class="btn btn-sm <%= item.matchCount > 0 ? 'btn-info' : 'btn-outline-info' %> position-relative py-0 px-2"
                                                        data-bs-toggle="modal" data-bs-target="#editItemModal"
                                                        data-id="<%= item.id %>" data-location="<%= item.location %>"
                                                        data-category="<%= item.category %>"
                                                        data-description="<%= item.description %>"
                                                        data-status="<%= item.status %>"
                                                        data-notes="<%= item.claim_notes %>"
                                                        style="font-size: 0.75rem;">
                                                        <i class="bi bi-check-all"></i>
                                                        <span class="ms-1 match-count">
                                                            <%= item.matchCount %>
                                                        </span>
                                                    </button>
                                                </div>
                                            </td>

                                            <!-- Action buttons for editing the item -->
                                            <td class="actions-cell">
                                                <div class="table-actions">
                                                    <button type="button" class="btn btn-outline-primary btn-sm"
                                                        data-bs-toggle="modal" data-bs-target="#editItemModal"
                                                        data-id="<%= item.id %>" data-location="<%= item.location %>"
                                                        data-category="<%= item.category %>"
                                                        data-description="<%= item.description %>"
                                                        data-status="<%= item.status %>"
                                                        data-notes="<%= item.claim_notes %>">
                                                        Edit
                                                    </button>

                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination Controls -->
                        <% if (totalPages> 1) { %>
                            <div class="pagination-container">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination">
                                        <% for(let i=1; i <=totalPages; i++) { %>
                                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                <a class="page-link"
                                                    href="/items?<%= buildItemsFilterQuery(i) %>"
                                                    <%= i %>
                                                </a>
                                            </li>
                                            <% } %>
                                    </ul>
                                </nav>
                            </div>
                            <% } %>

                                <% } %>
            </section>
        </div>
    </main>

    <!-- Include the shared footer layout from views/layouts/header.ejs -->
    <%- include("layouts/footer", { footerText: "University of Regina" }) %>

        <!-- Image Preview Modal -->
        <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content border-0 bg-transparent">
                    <div class="modal-header border-0 p-0">
                        <button type="button" class="btn-close btn-close-white ms-auto mb-2" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-0 text-center">
                        <img id="fullSizeImage" src="" alt="Full size preview" class="img-fluid rounded shadow-lg"
                            style="max-height: 85vh;">
                    </div>
                </div>
            </div>
        </div>

<!-- Edit Item Modal -->
<div class="modal fade" id="editItemModal" tabindex="-1" aria-labelledby="editItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editItemModalLabel">Edit Item State</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Form for updating item details -->
            <form id="editItemForm" method="POST" action="">
                <input
                    type="hidden"
                    name="redirectTo"
                    value="/items?<%= buildItemsFilterQuery(currentPage) %>"
                >

                <div class="modal-body">
                    <!-- Location -->
                    <div class="mb-3">
                        <label for="modal-location" class="form-label">Location</label>
                        <select id="modal-location" name="location" class="form-select" required>
                            <option value="" disabled>Select location</option>

                            <!-- Special value used when saved DB value is "Other - Something" -->
                            <option value="__other__">Other</option>

                            <!-- Shared saved location options -->
                            <% safeLocationOptions.forEach(function(option) { %>
                                <option value="<%= option %>"><%= option %></option>
                            <% }) %>
                        </select>

                        <!-- Hidden textbox shown only when Other is selected -->
                        <div id="modal-other-location-wrapper" class="mt-3" style="display:none;">
                            <label for="modal-other-location" class="form-label">Other Location</label>
                            <input
                                type="text"
                                id="modal-other-location"
                                name="otherLocation"
                                class="form-control"
                                placeholder="Enter the location"
                            />
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="mb-3">
                        <label for="modal-category" class="form-label">Category</label>
                        <select id="modal-category" name="category" class="form-select" required>
                            <option value="" disabled>Select category</option>

                            <!-- Special value used when saved DB value is "Other - Something" -->
                            <option value="__other__">Other</option>

                            <!-- Shared saved category options -->
                            <% safeCategoryOptions.forEach(function(option) { %>
                                <option value="<%= option %>"><%= option %></option>
                            <% }) %>
                        </select>

                        <!-- Hidden textbox shown only when Other is selected -->
                        <div id="modal-other-category-wrapper" class="mt-3" style="display:none;">
                            <label for="modal-other-category" class="form-label">Other Category</label>
                            <input
                                type="text"
                                id="modal-other-category"
                                name="otherCategory"
                                class="form-control"
                                placeholder="Enter the category"
                            />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="modal-description" class="form-label">Description</label>
                        <textarea
                            id="modal-description"
                            name="description"
                            class="form-control"
                            rows="3"
                            required
                        ></textarea>
                    </div>

                    <hr>

                    <!-- Status -->
                    <div class="mb-3">
                        <label for="modal-status" class="form-label">Item Status</label>
                        <select id="modal-status" name="status" class="form-select">
                            <option value="available">Available</option>
                            <option value="pending_pickup">Pending Pickup</option>
                            <option value="returned">Archived</option>
                        </select>
                    </div>

                    <!-- Claim notes -->
                    <div class="mb-3">
                        <label for="modal-claim-notes" class="form-label">Claim Notes</label>
                        <textarea
                            id="modal-claim-notes"
                            name="claim_notes"
                            class="form-control"
                            rows="2"
                            placeholder="Notes about the claim/return process..."
                        ></textarea>
                    </div>

                    <hr>

                    <!-- Potential Matches Section -->
                    <div class="mt-3">
                        <h6 class="fw-bold">
                            <i class="bi bi-check-all me-2"></i>Potential Matches (Reports)
                        </h6>
                        <div
                            id="item-matches-container"
                            class="list-group list-group-flush border rounded"
                            style="max-height: 200px; overflow-y: auto;"
                        >
                            <div class="p-3 text-center text-muted small">Loading potential matches...</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <!-- Delete button -->
                    <button type="button" class="btn btn-outline-danger" id="deleteItemBtn">Delete Item</button>

                    <div>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn btn-brand">Update Item</button>
                    </div>
                </div>
            </form>

            <!-- Hidden delete form submitted by JS -->
            <form id="deleteItemForm" method="POST" action="" style="display:none;"></form>
        </div>
    </div>
</div>

        <!-- JavaScript to handle modal population and deletion confirmation -->
        <script>
    document.addEventListener('DOMContentLoaded', function () {
        const editItemModal = document.getElementById('editItemModal');

        if (!editItemModal) {
            return;
        }

        const locationSelect = document.getElementById('modal-location');
        const categorySelect = document.getElementById('modal-category');

        const otherLocationWrapper = document.getElementById('modal-other-location-wrapper');
        const otherLocationInput = document.getElementById('modal-other-location');

        const otherCategoryWrapper = document.getElementById('modal-other-category-wrapper');
        const otherCategoryInput = document.getElementById('modal-other-category');

        // Get the normal dropdown values only
        function getSelectableValues(selectElement) {
            return Array.from(selectElement.options)
                .map(function (option) {
                    return option.value;
                })
                .filter(function (value) {
                    return value && value !== '__other__';
                });
        }

        // Split saved values like "Other - Wallet" into:
        // dropdown = "__other__"
        // textbox = "Wallet"
        function splitOtherValue(savedValue, allowedValues) {
            const safeValue = String(savedValue || '').trim();

            if (!safeValue) {
                return {
                    selectValue: '',
                    otherText: ''
                };
            }

            if (allowedValues.includes(safeValue)) {
                return {
                    selectValue: safeValue,
                    otherText: ''
                };
            }

            return {
                selectValue: '__other__',
                otherText: safeValue.replace(/^Other\s*-\s*/i, '')
            };
        }

        // Show or hide the Other textbox
        function toggleOtherField(selectElement, wrapperElement, inputElement) {
            const usingOther = selectElement.value === '__other__';

            wrapperElement.style.display = usingOther ? '' : 'none';
            inputElement.required = usingOther;

            if (!usingOther) {
                inputElement.value = '';
            }
        }

        locationSelect.addEventListener('change', function () {
            toggleOtherField(locationSelect, otherLocationWrapper, otherLocationInput);
        });

        categorySelect.addEventListener('change', function () {
            toggleOtherField(categorySelect, otherCategoryWrapper, otherCategoryInput);
        });

        editItemModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            const id = button.getAttribute('data-id');
            const location = button.getAttribute('data-location');
            const category = button.getAttribute('data-category');
            const description = button.getAttribute('data-description');
            const status = button.getAttribute('data-status');
            const notes = button.getAttribute('data-notes');

            const form = document.getElementById('editItemForm');
            form.action = '/items/' + id;

            // Fill location
            const allowedLocations = getSelectableValues(locationSelect);
            const splitLocation = splitOtherValue(location, allowedLocations);

            locationSelect.value = splitLocation.selectValue;
            otherLocationInput.value = splitLocation.otherText;
            toggleOtherField(locationSelect, otherLocationWrapper, otherLocationInput);

            // Fill category
            const allowedCategories = getSelectableValues(categorySelect);
            const splitCategory = splitOtherValue(category, allowedCategories);

            categorySelect.value = splitCategory.selectValue;
            otherCategoryInput.value = splitCategory.otherText;
            toggleOtherField(categorySelect, otherCategoryWrapper, otherCategoryInput);

            // Fill the rest
            document.getElementById('modal-description').value = description || '';
            document.getElementById('modal-status').value = status || 'available';
            document.getElementById('modal-claim-notes').value = (notes && notes !== 'null') ? notes : '';

            // Delete button
            const deleteBtn = document.getElementById('deleteItemBtn');
            deleteBtn.onclick = function () {
                if (confirm('Are you sure you want to permanently delete this item? This action cannot be undone.')) {
                    const deleteForm = document.getElementById('deleteItemForm');
                    deleteForm.action = '/items/' + id + '/delete';
                    deleteForm.submit();
                }
            };

            // Fetch potential matches
            const matchesContainer = document.getElementById('item-matches-container');
            matchesContainer.innerHTML = '<div class="p-3 text-center text-muted small">Searching for matches...</div>';

            fetch(`/api/matches/item/${id}`)
                .then(res => res.json())
                .then(matches => {
                    if (matches.length === 0) {
                        matchesContainer.innerHTML = '<div class="p-3 text-center text-muted small">No potential report matches found.</div>';
                    } else {
                        matchesContainer.innerHTML = matches.map(m => `
                            <a href="/reports/${m.id}/edit" class="list-group-item list-group-item-action p-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold small">Report #${m.id}</div>
                                        <div class="text-muted small">${m.category} - ${m.location || m.last_known_location || ''}</div>
                                        <div class="small">${(m.description || '').substring(0, 50)}...</div>
                                    </div>
                                    <span class="badge bg-info text-dark">${m.score}%</span>
                                </div>
                            </a>
                        `).join('');
                    }
                })
                .catch(() => {
                    matchesContainer.innerHTML = '<div class="p-3 text-center text-danger small">Error loading matches.</div>';
                });
        });
    });
</script>